# Reach Developments Station — MVP 1.0
#
# Copy to `.env` for local development:  cp .env.example .env
# Placeholders only. Never commit real credentials to this repository.

# Service identity reported by GET /api/v1/health/live
APP_NAME=reach-developments-station

# One of: development | test | staging | production
APP_ENV=development

# Must be false when APP_ENV=production (enforced in app/core/config.py)
APP_DEBUG=true

# PostgreSQL connection string.
#   - Required when APP_ENV=production; there is no production default.
#   - Render's own PostgreSQL URLs (postgres:// or postgresql://) are accepted
#     as-is; the Psycopg 3 driver is applied centrally in app/core/config.py.
#   - Use Render's INTERNAL connection URL when the web service and the
#     database live in the same Render region.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/reach_station

# Root path reserved for every JSON API in MVP 1.0
API_V1_PREFIX=/api/v1

# Lifetime of a server-side session, in minutes (5 minutes to 7 days).
# Roughly one working day by default. There are no refresh tokens and no
# remember-me: when this expires, the user signs in again.
SESSION_TTL_MINUTES=480

# There is deliberately no JWT secret, no token signing key and no bootstrap
# admin password here. Sessions are opaque random tokens stored as SHA-256
# digests in PostgreSQL, and the first administrator is created interactively
# with `python -m app.modules.access.bootstrap_admin` — see docs/DEPLOYMENT.md.
